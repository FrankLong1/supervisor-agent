# Copy to ~/.config/codex-unread-supervisor/inbox.env with mode 0600.
# The Cloud SQL Auth Proxy must already listen on the selected loopback port.
SUPERVISOR_INBOX_MODE=poll
SUPERVISOR_INBOX_DSN="host=127.0.0.1 port=55430 dbname=agent_inbox user=YOUR_GOOGLE_EMAIL sslmode=disable"
SUPERVISOR_INBOX_INSTANCE_ID=stable-workstation-instance
SUPERVISOR_INBOX_AGENT_ID=YOUR_IMMUTABLE_AGENT_UUID
SUPERVISOR_INBOX_AGENT_ADDRESS=YOUR_GOOGLE_EMAIL
SUPERVISOR_INBOX_SCHEMA=public
SUPERVISOR_COCKPIT_THREAD_ID=
SUPERVISOR_INBOX_CLAIM_SECONDS=120
